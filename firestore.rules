rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signedIn(){return request.auth!=null;}
   function adminUser(){return signedIn() && request.auth.token.admin==true;}
   match /students/{id}{
      allow get: if adminUser() || (signedIn() && request.auth.uid==id);
      allow list: if adminUser();
      allow create: if signedIn() && request.auth.uid==id && request.resource.data.keys().hasOnly(['name','phone','email','course','batch','createdAt','disabled']) && request.resource.data.disabled==false;
      allow update,delete: if false;
   }
   match /exams/{id}{allow read: if signedIn();allow write: if false;}
   match /examPrivate/{id}{allow read,write: if false;}
   match /attempts/{id}{allow read,write: if false;}
   match /results/{id}{
     allow get,list: if adminUser() || (signedIn() && resource.data.studentId==request.auth.uid && resource.data.published==true && resource.data.deleted==false);
     allow write: if false;
   }
   match /notices/{id}{allow read: if signedIn() && resource.data.active==true;allow write: if false;}
   match /auditLogs/{id}{allow read,write: if false;}
 }
}
